# Somente backend. Nunca use VITE_DATABASE_URL ou VITE_JWT_SECRET.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST.neon.tech/neondb?sslmode=require
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_DE_PELO_MENOS_32_BYTES
JWT_ISSUER=minha-escala-api
JWT_AUDIENCE=minha-escala-web
APP_URL=http://localhost:5173
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
# false em produção; use dotnet ef database update como etapa de implantação.
APPLY_MIGRATIONS=false
# Sem SMTP, somente Development registra o link de recuperação no terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=StartTls
