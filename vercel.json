{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": { "root": ".", "runtime": "container", "entrypoint": "Dockerfile.vercel" }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "backend" } },
    { "source": "/health", "destination": { "service": "backend" } },
    { "source": "/", "destination": "https://example.invalid/" },
    { "source": "/:path*", "destination": "https://example.invalid/:path*" }
  ],
  "git": { "deploymentEnabled": false }
}
